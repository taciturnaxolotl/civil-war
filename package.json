{
	"name": "civil-war",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"test": "bun test",
		"og": "bun scripts/og-image.mjs",
		"check": "tsc --noEmit",
		"db:migrate": "wrangler d1 migrations apply civil-war --local",
		"db:migrate:remote": "wrangler d1 migrations apply civil-war --remote",
		"deploy": "bun run db:migrate:remote && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261012.1",
		"@types/bun": "^1.4.3",
		"typescript": "^7.0.2",
		"wrangler": "^4.149.0"
	}
}
