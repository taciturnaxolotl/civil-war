{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "civil-war",
	"account_id": "fdbe5b542ede643d34962c1f07a34565",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"binding": "ASSETS",
		"directory": "public",
		// The API lives in the worker; everything else is a static file.
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "civil-war",
			// Replace with the id printed by `wrangler d1 create civil-war`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
