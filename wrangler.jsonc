{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "civil-war",
	"account_id": "fdbe5b542ede643d34962c1f07a34565",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"binding": "ASSETS",
		"directory": "public",
		// The API lives in the worker; everything else is a static file. The
		// home page also passes through so its social tags get absolute URLs.
		"run_worker_first": [
			"/api/*",
			"/"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "civil-war",
			"database_id": "d65638d4-4a8b-485f-80d5-0716cbd0cf66",
			"migrations_dir": "migrations"
		}
	]
}